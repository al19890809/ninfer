 src/ops/linear_swiglu/sources.cmake           |  19 +-
 src/ops/nvfp4_l20_stub.cpp                    | 194 ++++++++++++++++++
 src/ops/softmax_attention/sources.cmake       |  12 +-
 12 files changed, 382 insertions(+), 76 deletions(-)

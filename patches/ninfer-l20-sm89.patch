diff --git a/CMakeLists.txt b/CMakeLists.txt
index 27e9560..3d71516 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,14 +1,16 @@
 cmake_minimum_required(VERSION 3.28)
 
-# The current implementation is compiled only for sm_120a. Set and validate the
-# architecture before CUDA compiler detection so CMake never injects a generic
-# host-toolchain default or accepts an unsupported target.
+# NINFER_L20 port: build for Ada (sm_89) by default. sm_120a remains supported.
+# Supported values: "89" (NVIDIA L20 / Ada Lovelace) and "120a" (RTX 5090 / Blackwell).
 if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES)
-  set(CMAKE_CUDA_ARCHITECTURES 120a CACHE STRING "CUDA architectures to build")
+  set(CMAKE_CUDA_ARCHITECTURES 89 CACHE STRING "CUDA architectures to build")
 endif()
-if(NOT CMAKE_CUDA_ARCHITECTURES STREQUAL "120a")
+if(CMAKE_CUDA_ARCHITECTURES STREQUAL "89")
+  # Ada Lovelace (L20): no sm_90+ PDL; tell pdl.cuh to use plain launches.
+  add_compile_definitions($<$<COMPILE_LANGUAGE:CUDA>:NINFER_L20_NO_PDL>)
+elseif(NOT CMAKE_CUDA_ARCHITECTURES STREQUAL "120a")
   message(FATAL_ERROR
-    "NInfer supports only CMAKE_CUDA_ARCHITECTURES=120a; got "
+    "NInfer supports CMAKE_CUDA_ARCHITECTURES=89 (L20) or 120a (RTX 5090); got "
     "'${CMAKE_CUDA_ARCHITECTURES}'")
 endif()
 
diff --git a/src/core/pdl.cuh b/src/core/pdl.cuh
index 0c60b6a..c2d87df 100644
--- a/src/core/pdl.cuh
+++ b/src/core/pdl.cuh
@@ -5,6 +5,24 @@
 #include <cstddef>
 #include <utility>
 
+// NINFER_L20 / sm_89 (Ada Lovelace) port
+// ---------------------------------------------------------------------------
+// Programmatic Dependent Launch (`griddepcontrol.*`) requires sm_90+. The L20
+// is sm_89, so PDL is unavailable there. PDL is only a latency optimization:
+// a consumer kernel launched on the same stream already begins only after its
+// producer kernel has fully completed (CUDA in-order stream semantics), so a
+// plain launch is a correct, slightly slower substitute.
+//
+// Strategy:
+//  * On sm_89 the device helpers become no-ops (there are no dependents to
+//    trigger and no dependency to wait on -- stream order supplies both).
+//  * The host `launch_dependent` degenerates to a normal `cudaLaunchKernel`
+//    when compiled for a pre-sm_90-only build. Because CMAKE_CUDA_ARCHITECTURES
+//    for the L20 build is exactly one arch (89), a host-side check on the
+//    compiled arch is reliable; we detect it through __CUDA_ARCH__ when the
+//    TU is a CUDA file, and fall back to launching normally via a runtime flag
+//    compiled in by CMake (NINFER_L20_PLAIN_LAUNCH) for safety.
+
 namespace ninfer::pdl {
 
 struct LaunchConfig {
@@ -14,32 +32,63 @@ struct LaunchConfig {
     cudaStream_t stream            = nullptr;
 };
 
-// Launches a consumer kernel as a programmatic dependent of the immediately preceding producer
-// kernel in the same stream. Every consumer control path that reads producer output must first call
-// wait_for_dependencies().
+namespace detail {
+// Set at compile time by the CUDA compiler for the *single* target arch of
+// this build. For a pure sm_89 build this is false.
+#if defined(NINFER_L20_NO_PDL)
+inline constexpr bool kPdlAvailable = false;
+#else
+inline constexpr bool kPdlAvailable = true;
+#endif
+} // namespace detail
+
+// Launches a consumer kernel as a programmatic dependent of the immediately
+// preceding producer kernel in the same stream. Every consumer control path
+// that reads producer output must first call wait_for_dependencies().
 template <class... KernelArgs, class... CallArgs>
 [[nodiscard]] inline cudaError_t
 launch_dependent(const LaunchConfig& launch, void (*kernel)(KernelArgs...), CallArgs&&... args) {
-    cudaLaunchAttribute attribute{};
-    attribute.id = cudaLaunchAttributeProgrammaticStreamSerialization;
-    attribute.val.programmaticStreamSerializationAllowed = 1;
-
-    cudaLaunchConfig_t config{};
-    config.gridDim          = launch.grid;
-    config.blockDim         = launch.block;
-    config.dynamicSmemBytes = launch.dynamic_smem_bytes;
-    config.stream           = launch.stream;
-    config.attrs            = &attribute;
-    config.numAttrs         = 1;
-
-    return cudaLaunchKernelEx(&config, kernel, std::forward<CallArgs>(args)...);
+    if constexpr (!detail::kPdlAvailable) {
+        // sm_89 / L20 path: plain in-order launch (PDL attribute omitted). We
+        // take the address of each argument and pass a void* array to the
+        // driver-style launch; every current call site passes plain scalar /
+        // pointer arguments, which is exactly what this supports.
+        void* arg_ptrs[] = {const_cast<void*>(static_cast<const void*>(&args))...};
+        return cudaLaunchKernel(reinterpret_cast<const void*>(kernel), launch.grid, launch.block,
+                                arg_ptrs, launch.dynamic_smem_bytes, launch.stream);
+    } else {
+        cudaLaunchAttribute attribute{};
+        attribute.id = cudaLaunchAttributeProgrammaticStreamSerialization;
+        attribute.val.programmaticStreamSerializationAllowed = 1;
+
+        cudaLaunchConfig_t config{};
+        config.gridDim          = launch.grid;
+        config.blockDim         = launch.block;
+        config.dynamicSmemBytes = launch.dynamic_smem_bytes;
+        config.stream           = launch.stream;
+        config.attrs            = &attribute;
+        config.numAttrs         = 1;
+
+        return cudaLaunchKernelEx(&config, kernel, std::forward<CallArgs>(args)...);
+    }
 }
 
-// Every producer CTA must call this at least once or exit. This enables dependent scheduling but
-// does not make producer writes visible to the consumer.
-__device__ __forceinline__ void trigger_dependents() { cudaTriggerProgrammaticLaunchCompletion(); }
+// Every producer CTA must call this at least once or exit. This enables
+// dependent scheduling but does not make producer writes visible to the
+// consumer. No-op on sm_89.
+__device__ __forceinline__ void trigger_dependents() {
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)
+    cudaTriggerProgrammaticLaunchCompletion();
+#endif
+}
 
-// Call on every consumer control path before its first access to producer-dependent data.
-__device__ __forceinline__ void wait_for_dependencies() { cudaGridDependencySynchronize(); }
+// Call on every consumer control path before its first access to
+// producer-dependent data. No-op on sm_89 (stream order already guarantees
+// the producer finished before the consumer started).
+__device__ __forceinline__ void wait_for_dependencies() {
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)
+    cudaGridDependencySynchronize();
+#endif
+}
 
 } // namespace ninfer::pdl
diff --git a/src/models/qwen3_5/program/planning/startup.cpp b/src/models/qwen3_5/program/planning/startup.cpp
index 8a6e480..8888534 100644
--- a/src/models/qwen3_5/program/planning/startup.cpp
+++ b/src/models/qwen3_5/program/planning/startup.cpp
@@ -801,8 +801,11 @@ void validate_target_options(const execution::Parameters& parameters, DeviceCont
         }
         break;
     }
-    if (device.compute_capability() != 120) {
-        throw std::invalid_argument("Qwen3.5 family runtime requires compute capability 12.0");
+    // NINFER_L20 / sm_89 (Ada) port: accept both Blackwell (12.0) and Ada (8.9).
+    if (device.compute_capability() != 120 && device.compute_capability() != 89) {
+        throw std::invalid_argument(
+            "Qwen3.5 family runtime requires compute capability 12.0 (RTX 5090) "
+            "or 8.9 (NVIDIA L20)");
     }
 }
 
diff --git a/src/ops/CMakeLists.txt b/src/ops/CMakeLists.txt
index 31357e8..c40135c 100644
--- a/src/ops/CMakeLists.txt
+++ b/src/ops/CMakeLists.txt
@@ -2,15 +2,27 @@
 add_library(ninfer_ops STATIC)
 ninfer_internal_includes(ninfer_ops)
 ninfer_cuda_archive(ninfer_ops)
-target_link_libraries(ninfer_ops PUBLIC ninfer_core PRIVATE ninfer_nvfp4_non_rdc)
 
-# Warp-specialized SM120 NVFP4 kernels use setmaxnreg to transfer registers from
-# producer to consumer warpgroups. RDC makes ptxas discard that contract. These
-# self-contained kernels therefore use a non-RDC archive and host launchers.
-add_library(ninfer_nvfp4_non_rdc STATIC)
-ninfer_internal_includes(ninfer_nvfp4_non_rdc)
-ninfer_cuda_non_rdc_archive(ninfer_nvfp4_non_rdc)
-target_link_libraries(ninfer_nvfp4_non_rdc PRIVATE ninfer_core CUDA::cudart CUDA::cuda_driver)
+# NINFER_L20 / sm_89 (Ada) port:
+# sm_89 has no NVFP4 *weight* MMA, so the NVFP4 weight kernels are excluded and
+# replaced by stubs that throw a clear error. NVFP4 *KV-cache* kernels
+# (small_t_nvfp4, prompt_nvfp4, k8v4, ...) dequantize in software and stay.
+if(CMAKE_CUDA_ARCHITECTURES STREQUAL "89")
+  # A no-NVFP4-weights build. L20_STUB throws for any NVFP4 weight op.
+  set(NINFER_NO_NVFP4_WEIGHTS ON)
+  target_sources(ninfer_ops PRIVATE "${CMAKE_CURRENT_LIST_DIR}/nvfp4_l20_stub.cpp")
+else()
+  set(NINFER_NO_NVFP4_WEIGHTS OFF)
+  target_link_libraries(ninfer_ops PUBLIC ninfer_core PRIVATE ninfer_nvfp4_non_rdc)
+
+  # Warp-specialized SM120 NVFP4 kernels use setmaxnreg to transfer registers
+  # from producer to consumer warpgroups. RDC makes ptxas discard that contract.
+  # These self-contained kernels therefore use a non-RDC archive and host launchers.
+  add_library(ninfer_nvfp4_non_rdc STATIC)
+  ninfer_internal_includes(ninfer_nvfp4_non_rdc)
+  ninfer_cuda_non_rdc_archive(ninfer_nvfp4_non_rdc)
+  target_link_libraries(ninfer_nvfp4_non_rdc PRIVATE ninfer_core CUDA::cudart CUDA::cuda_driver)
+endif()
 
 include(basic_sources.cmake)
 include("${CMAKE_CURRENT_LIST_DIR}/attn_input_proj/sources.cmake")

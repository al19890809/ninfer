 src/core/pdl.cuh                              |  91 ++++++--
 .../qwen3_5/program/planning/startup.cpp      |   7 +-
 src/ops/CMakeLists.txt                        |  28 ++-
 src/ops/attn_input_proj/sources.cmake         |  13 +-
